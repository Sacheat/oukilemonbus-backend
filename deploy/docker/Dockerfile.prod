# Image de production : le code et les dépendances sont copiés dans l'image (pas de volume sur le code comme en dev).
# Construite par deploy/docker/docker-compose.prod.yml, contexte = racine du dépôt.
#   cible « app » : php-fpm, utilisée aussi par le worker de file et le scheduler
#   cible « web » : nginx avec le dossier public/ de l'application

FROM php:8.4-fpm AS app

RUN apt-get update && apt-get install -y --no-install-recommends \
        git unzip \
        libzip-dev libpng-dev libjpeg-dev libfreetype6-dev \
        libonig-dev libxml2-dev libicu-dev \
    && docker-php-ext-configure gd --with-freetype --with-jpeg \
    && docker-php-ext-install \
        pdo_mysql \
        mbstring \
        zip \
        intl \
        gd \
        bcmath \
        exif \
        pcntl \
        opcache \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer
COPY deploy/docker/php/production.ini /usr/local/etc/php/conf.d/zz-production.ini

WORKDIR /var/www/html

# Dépendances d'abord : cette couche reste en cache tant que composer.lock ne change pas.
COPY composer.json composer.lock ./
RUN composer install --no-dev --no-scripts --no-autoloader --prefer-dist --no-interaction --no-progress

COPY . .
# Les dossiers de cache de storage/ sont exclus du contexte (.dockerignore) mais Laravel en a besoin pour démarrer
# (package:discover lancé par dump-autoload). En production, storage/ est remplacé par un volume (entrypoint.sh).
RUN mkdir -p storage/framework/cache/data storage/framework/sessions storage/framework/views storage/logs \
    && composer dump-autoload --optimize --no-dev --no-interaction \
    && chown -R www-data:www-data storage bootstrap/cache

COPY deploy/docker/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["php-fpm"]


FROM nginx:1.27-alpine AS web

COPY deploy/docker/nginx/default.conf /etc/nginx/conf.d/default.conf
COPY --from=app /var/www/html/public /var/www/html/public
