# Modèle de .env de production, commun aux deux options (Docker ou installation directe sur la VM).
# Copier en .env à la racine du dépôt sur la VM, puis remplacer chaque <...>. Guide : deploy/README.md.
# Ne jamais commiter le .env rempli.

APP_NAME="Bus Communal"
APP_ENV=production
# Généré à la première installation (voir deploy/README.md)
APP_KEY=
APP_DEBUG=false
# URL publique de l'API, en https
APP_URL=https://<domaine-api>

# SPA frontend (liens envoyés par email)
FRONTEND_URL=https://<domaine-frontend>
FRONTEND_EMAIL_VERIFICATION_PATH=/verify-email
FRONTEND_PASSWORD_RESET_PATH=/reset-password

# Outils de dev : toujours désactivés en production
BACKEND_INSPECTOR_ENABLED=false
BACKEND_INSPECTOR_RETENTION_DAYS=14
DEV_TOOLBOX_ENABLED=false

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_BE

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Un fichier de log par jour, gardé LOG_DAILY_DAYS jours
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info
LOG_DAILY_DAYS=14
LOG_RESERVATIONS_LEVEL=info
LOG_ROUTING_LEVEL=warning
LOG_DOCUMENTS_LEVEL=info
LOG_JOBS_LEVEL=info

# RGPD : durées de conservation en jours (config/privacy.php, 0 = purge désactivée)
PRIVACY_RETENTION_DRIVER_POSITIONS_DAYS=90
PRIVACY_RETENTION_IDEMPOTENCY_KEYS_DAYS=7
PRIVACY_RETENTION_DOCUMENT_ACCESS_LOGS_DAYS=365
PRIVACY_RETENTION_DOMAIN_EVENTS_DAYS=1095
PRIVACY_RETENTION_INACTIVE_ACCOUNTS_DAYS=1095
PRIVACY_INACTIVE_ACCOUNTS_WARNING_DAYS=30
# Politique de confidentialité (page de la SPA) ; changer la version redemande sa lecture à tous
PRIVACY_POLICY_VERSION=2026-10-12
PRIVACY_POLICY_URL=

BACKUP_PATH=
BACKUP_RETENTION_DAYS=14
# Obligatoire en production (sinon backup:run échoue) : clé générée par php artisan backup:generate-key,
# à garder aussi hors de la VM (sans elle, les backups sont irrécupérables).
BACKUP_ENCRYPTION_ENABLED=true
BACKUP_ENCRYPTION_KEY=<php artisan backup:generate-key>

# Docker : DB_HOST=mariadb (le conteneur de la stack, créé avec ces identifiants).
# Sans Docker : DB_HOST=localhost (socket local) et une base créée à la main (voir deploy/README.md).
DB_CONNECTION=mysql
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=bus_communal
DB_USERNAME=bus_user
# Mots de passe longs et aléatoires : openssl rand -base64 24
DB_PASSWORD=<mot-de-passe-base>
# Docker uniquement : mot de passe root du conteneur MariaDB
DB_ROOT_PASSWORD=<mot-de-passe-root-base>

SESSION_DRIVER=database
SESSION_LIFETIME=120
# Contenu des sessions chiffré en base (RGPD). Passer de false à true déconnecte une fois les sessions ouvertes.
SESSION_ENCRYPT=true
SESSION_PATH=/
# Domaine parent commun à l'API et au frontend si la SPA utilise les cookies (ex. .exemple.be), sinon null
SESSION_DOMAIN=null
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_SECURE_COOKIE=true
SESSION_PARTITIONED_COOKIE=false
# Domaine(s) du frontend, sans https://
SANCTUM_STATEFUL_DOMAINS=<domaine-frontend>
SANCTUM_TOKEN_PREFIX=bc_
SANCTUM_TOKEN_EXPIRATION=10080
# Origine(s) du frontend, avec https://
CORS_ALLOWED_ORIGINS=https://<domaine-frontend>

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
QUEUE_NAME_CRITICAL=critical
QUEUE_NAME_DEFAULT=default
QUEUE_NAME_LOW=low
QUEUE_WORKER_QUEUES=critical,default,low
# Supérieur au plus long timeout des jobs (180 s), voir config/queue.php
DB_QUEUE_RETRY_AFTER=240

CACHE_STORE=database

# Brevo (SMTP transactionnel). Identifiant et clé : Brevo > SMTP & API > SMTP.
# L'adresse d'envoi doit être sur un domaine authentifié dans Brevo (SPF, DKIM, DMARC), sinon spam.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=<identifiant-smtp-brevo>
MAIL_PASSWORD=<cle-smtp-brevo>
MAIL_FROM_ADDRESS="no-reply@<domaine-authentifie>"
MAIL_FROM_NAME="${APP_NAME}"

NOTIFICATIONS_LAST_MINUTE_CANCELLATION_HOURS=24
NOTIFICATIONS_COOLDOWN_MINUTES=15
NOTIFICATIONS_MAIL_MAX_ATTACHMENT_BYTES=5242880
NOTIFICATIONS_SIGNED_LINK_EXPIRATION_MINUTES=1440
NOTIFICATIONS_DIGEST_HOURLY_MINUTE=5
NOTIFICATIONS_DIGEST_DAILY_HOUR=8
NOTIFICATIONS_DIGEST_DAILY_MINUTE=0
NOTIFICATIONS_OBS_MAX_FAILED_DELIVERIES_24H=20
NOTIFICATIONS_OBS_MAX_HIGH_PENDING_OVER_5M=0
NOTIFICATIONS_OBS_MAX_LATE_DIGESTS_OVER_30M=10

ORS_API_KEY=<cle-openrouteservice>
ORS_BASE_URL=https://api.heigit.org

MUNICIPALITY_NAME=Dinant
MUNICIPALITY_LOCALITIES=Dinant,Anseremme,Bouvignes-sur-Meuse,Drehance,Falmagne,Falmignoul,Furfooz,Lisogne,Sorinnes,Thynes

GEONAMES_BASE_URL=https://secure.geonames.org
GEONAMES_USERNAME=<utilisateur-geonames>
GEONAMES_MAX_ROWS=100

# --- Docker uniquement (deploy/docker/docker-compose.prod.yml) ---
# Adresse d'écoute du nginx de la stack. Garder 127.0.0.1 : il est toujours derrière un proxy HTTPS.
HTTP_BIND=127.0.0.1:8080
# Domaine de l'API si la stack gère elle-même le HTTPS (Caddy, ports 80/443 libres sur la VM).
# Laisser vide si un nginx de la VM relaie déjà vers HTTP_BIND.
CADDY_DOMAIN=
