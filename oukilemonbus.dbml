// ============================================================
// OuKiLéMonBus — Schéma DBML v7
// Mis à jour pour refléter l'état réel de la base de données
// après le merge de feature/backend-inspector dans main (juin 2026)
//
// Projet : Application de réservation du bus communal — Dinant
// ============================================================

Project oukilemonbus {
  database_type: "MySQL"
  Note: "Application de réservation du bus communal — Commune de Dinant"
}

// ============================================================
// ENUMS
// ============================================================

Enum organization_type {
  ecole_communale     [note: 'Prioritaire par défaut, quota exempt, auto-approuvé, récurrences autorisées']
  personnel_communal  [note: 'Personnel de la commune']
  cpas                [note: 'Centre Public d'Action Sociale']
  asbl                [note: 'Association sans but lucratif']
  externe             [note: 'Organisme externe à la commune']
}

Enum reservation_status {
  en_attente  [note: 'Créée, en attente de validation manuelle ou automatique']
  approuve    [note: 'Validée par un agent, chauffeur/véhicule assignés']
  confirme    [note: 'Confirmée (écoles auto-approuvées)']
  refuse      [note: 'Refusée définitivement']
  annule      [note: 'Annulée après création']
  en_conflit  [note: 'Créée mais bloquée par au moins un conflit non résolu']
}

Enum reservation_conflict_type {
  distance_not_calculated     [note: 'Distance non calculée via ORS (fallback Haversine échoué ou coordonnées manquantes)']
  schedule_overlap            [note: 'Chevauchement de planning avec une autre réservation']
  departure_before_08h        [note: 'Départ avant 08h00']
  return_after_17h            [note: 'Retour après 17h00']
  departure_before_allowed_time [note: 'Départ avant l heure autorisée configurable']
  return_after_allowed_time   [note: 'Retour après l heure autorisée — avertissement dérogation, pas hard-block']
  impossible_time_window      [note: 'Créneau impossible (aller-retour incohérent)']
  duration_over_allowed_limit [note: 'Durée maximale dépassée']
  quota_exceeded              [note: 'Quota annuel de l organisation dépassé']
  no_driver_available         [note: 'Aucun chauffeur disponible sur le créneau']
  no_vehicle_available        [note: 'Aucun véhicule disponible sur le créneau']
  vehicle_capacity_unavailable [note: 'Aucun véhicule de capacité suffisante disponible']
}

Enum reservation_activity_type {
  standard        [note: 'Sortie standard']
  gymnastique     [note: 'Activité gym — priorité interne entre écoles']
  psychomotricite [note: 'Psychomotricité — priorité interne entre écoles']
}

Enum approval_type_enum {
  auto    [note: 'Approuvé automatiquement (écoles communales)']
  manuel  [note: 'Approuvé manuellement par un agent']
}

Enum council_decision_status {
  en_attente [note: 'Décision du Collège en attente']
  approuve   [note: 'Décision favorable']
  refuse     [note: 'Décision défavorable']
}

Enum document_type_enum {
  feuille_route  [note: 'Feuille de route hebdomadaire ou journalière']
  attestation    [note: 'Attestation officielle']
  deliberation   [note: 'Délibération du Collège communal']
  planning       [note: 'Export planning']
  justificatif   [note: 'Pièce justificative téléversée (ASBL, demandes...)']
}

Enum request_status {
  en_attente [note: 'En attente de traitement par un agent']
  approuve   [note: 'Acceptée']
  refuse     [note: 'Refusée']
}

Enum unavailability_reason_type {
  driver  [note: 'Indisponibilité d un chauffeur']
  vehicle [note: 'Indisponibilité d un véhicule']
}

Enum assignment_type_enum {
  driver  [note: 'Changement de chauffeur']
  vehicle [note: 'Changement de véhicule']
}

Enum delivery_status {
  pending [note: 'En attente d envoi']
  sent    [note: 'Envoyé avec succès']
  failed  [note: 'Échec d envoi']
}

// ============================================================
// TABLES — DOMAINE MÉTIER
// ============================================================

// ─── 1. USERS ────────────────────────────────────────────────
Table users {
  id                bigint       [pk, increment, not null]
  first_name        varchar(100) [not null]
  last_name         varchar(255) [not null]
  email             varchar(255) [not null, unique]
  password          varchar(255) [not null]
  phone             varchar(20)
  active            boolean      [not null, default: true]
  email_verified_at timestamp
  remember_token    varchar(100)
  created_at        timestamp    [not null]
  updated_at        timestamp    [not null]

  indexes {
    (email)  [unique, name: 'uq_users_email']
    (active) [name: 'idx_users_active']
  }

  Note: 'Authentification Laravel sur email + mot de passe. Rôles gérés via Spatie laravel-permission : admin, agent_communal, responsable_organisation, user, chauffeur.'
}

// ─── 2. DRIVERS ──────────────────────────────────────────────
Table drivers {
  id                  bigint      [pk, increment, not null]
  user_id             bigint      [not null, unique, note: '1 seul profil chauffeur par utilisateur']
  licence_number      varchar(20) [not null, unique]
  licence_expiry_date date        [not null]
  is_active           boolean     [not null, default: true]
  created_at          timestamp   [not null]
  updated_at          timestamp   [not null]

  indexes {
    (user_id)             [unique, name: 'uq_drivers_user_id']
    (licence_number)      [unique, name: 'uq_drivers_licence_number']
    (licence_expiry_date) [name: 'idx_drivers_licence_expiry_date']
    (is_active)           [name: 'idx_drivers_is_active']
  }
}

// ─── 3. VEHICLES ─────────────────────────────────────────────
Table vehicles {
  id            bigint      [pk, increment, not null]
  licence_plate varchar(20) [not null, unique, note: 'Ex: 1-VJX-649']
  capacity      int         [not null, note: 'Nombre de places chauffeur compris']
  is_active     boolean     [not null, default: true]
  created_at    timestamp   [not null]
  updated_at    timestamp   [not null]

  indexes {
    (licence_plate) [unique, name: 'uq_vehicles_licence_plate']
    (is_active)     [name: 'idx_vehicles_is_active']
    (capacity)      [name: 'idx_vehicles_capacity']
  }
}

// ─── 4. LOCATIONS ────────────────────────────────────────────
Table locations {
  id                bigint        [pk, increment, not null]
  formatted_address varchar(500)  [not null]
  street            varchar(255)
  street_number     varchar(20)
  postal_code       varchar(20)
  city              varchar(100)  [not null]
  country           varchar(100)  [not null, default: 'Belgique']
  latitude          decimal(11,8)
  longitude         decimal(11,8)
  place_id          varchar(255)  [note: 'ID ORS / Google Maps — évite les doublons de géocodage']
  provider          varchar(50)   [note: 'openrouteservice | google']
  is_verified       boolean       [not null, default: false]
  created_at        timestamp     [not null]
  updated_at        timestamp     [not null]

  indexes {
    (city)                [name: 'idx_locations_city']
    (postal_code, city)   [name: 'idx_locations_postal_city']
    (latitude, longitude) [name: 'idx_locations_lat_lng']
    (place_id)            [name: 'idx_locations_place_id']
    (provider, place_id)  [name: 'idx_locations_provider_place_id']
    (is_verified)         [name: 'idx_locations_is_verified']
  }
}

// ─── 5. ORGANIZATIONS ────────────────────────────────────────
Table organizations {
  id                          bigint            [pk, increment, not null]
  name                        varchar(50)       [not null]
  type                        organization_type [not null]
  official_email              varchar(255)
  phone_contact               varchar(20)
  name_contact                varchar(255)
  location_id                 bigint            [note: 'Siège social géocodé']
  is_priority                 boolean           [not null, default: false, note: 'Prioritaire dans l ordonnancement']
  is_banned                   boolean           [not null, default: false, note: 'Organisation bannie — réservations bloquées']
  banned_reason               varchar(500)
  proof_document_id           bigint            [note: 'FK vers documents.id — justificatif statuts']
  annual_quota                int               [not null, default: 5, note: 'Max réservations/an — surtout asbl/externe']
  reservations_used_this_year int               [not null, default: 0, note: 'Cache métier — reset automatique 1er janvier']
  quota_reset_year            timestamp         [not null, default: `now()`]
  created_at                  timestamp         [not null]
  updated_at                  timestamp         [not null]

  indexes {
    (name)              [name: 'idx_organizations_name']
    (type)              [name: 'idx_organizations_type']
    (location_id)       [name: 'idx_organizations_location_id']
    (is_priority)       [name: 'idx_organizations_is_priority']
    (is_banned)         [name: 'idx_organizations_is_banned']
    (official_email)    [name: 'idx_organizations_official_email']
    (type, is_priority) [name: 'idx_organizations_type_priority']
    (quota_reset_year)  [name: 'idx_organizations_quota_reset_year']
  }
}

// ─── 6. USER_ORGANIZATION ────────────────────────────────────
Table user_organization {
  user_id           bigint      [not null]
  organization_id   bigint      [not null]
  relationship_type varchar(50) [not null, note: 'prof | directeur | animateur | responsable | referent']
  is_default        boolean     [not null, default: false, note: 'Organisation pré-sélectionnée à la connexion']
  created_at        timestamp   [not null]
  updated_at        timestamp   [not null]

  indexes {
    (user_id, organization_id)          [pk]
    (user_id)                           [name: 'idx_user_organization_user_id']
    (organization_id)                   [name: 'idx_user_organization_organization_id']
    (user_id, is_default)               [name: 'idx_user_organization_user_default']
    (organization_id, relationship_type) [name: 'idx_user_organization_org_role']
  }

  Note: 'Pivot Many-to-Many enrichi — clé primaire composite (user_id, organization_id).'
}

// ─── 7. RECURRENCES ──────────────────────────────────────────
Table recurrences {
  id               bigint      [pk, increment, not null]
  frequency        varchar(50) [not null, note: 'hebdomadaire | bihebdomadaire | mensuel']
  interval_value   int         [not null, note: 'Nombre de jours entre occurrences']
  days_of_week     varchar(50) [note: "Ex: '1,3' pour lundi et mercredi"]
  start_date       date        [not null]
  end_date         date        [not null]
  occurrence_count int         [note: 'Nb max occurrences (optionnel)']
  is_active        boolean     [not null, default: true]
  created_at       timestamp   [not null]
  updated_at       timestamp   [not null]

  indexes {
    (frequency)            [name: 'idx_recurrences_frequency']
    (start_date, end_date) [name: 'idx_recurrences_start_end']
    (is_active)            [name: 'idx_recurrences_is_active']
  }
}

// ─── 8. RESERVATIONS ─────────────────────────────────────────
Table reservations {
  id                      bigint                    [pk, increment, not null]
  requested_by_user_id    bigint                    [not null]
  organization_id         bigint                    [not null]
  pickup_location_id      bigint                    [not null]
  destination_location_id bigint                    [not null]
  driver_id               bigint
  vehicle_id              bigint
  recurrence_id           bigint
  trip_date               date                      [not null]
  departure_time          time                      [not null]
  return_time             time                      [not null]
  nb_children             int                       [not null, default: 0]
  nb_adults               int                       [not null]
  trip_purpose            varchar(500)              [not null]
  activity_type           reservation_activity_type [not null, default: 'standard']
  distance_km             decimal(6,2)
  estimated_duration_min  int
  status                  reservation_status        [not null]
  approval_type           approval_type_enum        [not null]
  validated_by_user_id    bigint
  validated_at            timestamp
  cancelled_by_user_id    bigint
  cancelled_at            timestamp
  rejection_reason        text
  cancellation_reason     text
  passengers_confirmed_at timestamp                 [note: 'Horodatage de la confirmation des passagers réels']
  created_at              timestamp                 [not null]
  updated_at              timestamp                 [not null]

  indexes {
    (trip_date, status)                  [name: 'idx_reservations_date_status']
    (organization_id, trip_date)         [name: 'idx_reservations_org_date']
    (requested_by_user_id)               [name: 'idx_reservations_requested_by_user_id']
    (pickup_location_id)                 [name: 'idx_reservations_pickup_location_id']
    (destination_location_id)            [name: 'idx_reservations_destination_location_id']
    (driver_id)                          [name: 'idx_reservations_driver_id']
    (vehicle_id)                         [name: 'idx_reservations_vehicle_id']
    (recurrence_id)                      [name: 'idx_reservations_recurrence_id']
    (status, approval_type)              [name: 'idx_reservations_status_approval_type']
    (validated_by_user_id)               [name: 'idx_reservations_validated_by_user_id']
    (cancelled_by_user_id)               [name: 'idx_reservations_cancelled_by_user_id']
    (trip_date, driver_id)               [name: 'idx_reservations_trip_date_driver_id']
    (trip_date, vehicle_id)              [name: 'idx_reservations_trip_date_vehicle_id']
    (organization_id, status, trip_date) [name: 'idx_reservations_org_status_date']
    (organization_id, activity_type)     [name: 'idx_reservations_org_activity_type']
  }

  Note: '''
  Règles métier :
  - return_time > departure_time
  - nb_adults >= 1
  - pickup_location_id != destination_location_id
  - Les dérogations (retour > 17h) sont gérées via CouncilDecision
  '''
}

// ─── 9. RESERVATION_CONFLICTS ────────────────────────────────
Table reservation_conflicts {
  id                     bigint                    [pk, increment, not null]
  reservation_id         bigint                    [not null]
  type                   reservation_conflict_type [not null]
  message                varchar(500)              [not null]
  related_reservation_id bigint                    [note: 'Réservation en chevauchement, si applicable']
  is_resolved            boolean                   [not null, default: false]
  resolved_by_user_id    bigint
  resolved_at            timestamp
  created_at             timestamp                 [not null]

  indexes {
    (reservation_id)         [name: 'idx_reservation_conflicts_reservation_id']
    (type)                   [name: 'idx_reservation_conflicts_type']
    (is_resolved)            [name: 'idx_reservation_conflicts_is_resolved']
    (related_reservation_id) [name: 'idx_reservation_conflicts_related_reservation_id']
    (resolved_by_user_id)    [name: 'idx_reservation_conflicts_resolved_by_user_id']
  }

  Note: 'Pas de updated_at — immuable sauf is_resolved/resolved_at/resolved_by_user_id.'
}

// ─── 10. COUNCIL_DECISIONS ───────────────────────────────────
Table council_decisions {
  id                  bigint                  [pk, increment, not null]
  reservation_id      bigint                  [not null, unique, note: 'Max 1 décision par réservation']
  decision_status     council_decision_status [not null]
  decision_date       date
  recorded_by_user_id bigint                  [not null]
  decision_reference  varchar(100)
  validated_at        timestamp
  notes               varchar(500)
  created_at          timestamp               [not null]
  updated_at          timestamp               [not null]

  indexes {
    (reservation_id)      [unique, name: 'uq_council_decisions_reservation_id']
    (decision_status)     [name: 'idx_council_decisions_status']
    (decision_date)       [name: 'idx_council_decisions_decision_date']
    (recorded_by_user_id) [name: 'idx_council_decisions_recorded_by_user_id']
    (decision_reference)  [name: 'idx_council_decisions_decision_reference']
  }
}

// ─── 11. DOCUMENTS ───────────────────────────────────────────
Table documents {
  id                 bigint             [pk, increment, not null]
  reservation_id     bigint             [note: 'Null pour les feuilles de route (lien via document_reservation)']
  user_id            bigint
  document_type      document_type_enum [not null]
  file_name          varchar(255)       [not null]
  file_path          varchar(500)       [not null, note: 'Chemin storage/app/private/...']
  mime_type          varchar(100)       [not null]
  file_size          int
  checksum           varchar(128)       [note: 'Hash du fichier pour détecter les doublons']
  generation_mode    varchar(50)        [not null, note: 'auto | manuel']
  generation_context json               [note: 'Snapshot des paramètres de génération (org, trip_date, etc.)']
  template_key       varchar(100)       [note: 'Ex: deliberations.school | route_sheets.weekly']
  template_version   varchar(30)        [note: 'Version du template utilisé']
  generated_at       timestamp
  is_official        boolean            [not null, default: false]
  version            int                [not null, default: 1]
  is_available       boolean            [not null, default: true, note: 'false = expiré ou supprimé']
  created_at         timestamp          [not null]
  updated_at         timestamp          [not null]

  indexes {
    (reservation_id)                [name: 'idx_documents_reservation_id']
    (user_id)                       [name: 'idx_documents_user_id']
    (document_type)                 [name: 'idx_documents_document_type']
    (generated_at)                  [name: 'idx_documents_generated_at']
    (is_official)                   [name: 'idx_documents_is_official']
    (is_available)                  [name: 'idx_documents_is_available']
    (reservation_id, document_type) [name: 'idx_documents_reservation_type']
    (document_type, is_available)   [name: 'idx_documents_type_available']
    (mime_type)                     [name: 'idx_documents_mime_type']
    (checksum)                      [name: 'idx_documents_checksum']
    (template_key)                  [name: 'idx_documents_template_key']
  }

  Note: 'CHECK : file_size IS NULL OR file_size >= 0 ; version >= 1. Archivage recommandé : feuilles de route 3 ans minimum.'
}

// ─── 11b. DOCUMENT_RESERVATION ───────────────────────────────
Table document_reservation {
  document_id    bigint [not null]
  reservation_id bigint [not null]
  position       int    [not null, note: 'Ordre de la réservation dans le document']
  created_at     timestamp
  updated_at     timestamp

  indexes {
    (document_id, reservation_id) [pk]
    (document_id, position)       [unique, name: 'uq_document_reservation_document_position']
    (reservation_id)              [name: 'idx_document_reservation_reservation_id']
  }

  Note: 'Pivot Many-to-Many entre feuilles de route et réservations. Position conserve l ordre dans le document généré.'
}

// ─── 12. NOTIFICATIONS ───────────────────────────────────────
Table notifications {
  id              uuid         [pk, not null]
  type            varchar(255) [not null, note: 'FQCN de la classe de notification Laravel']
  notifiable_type varchar(255) [not null, note: 'Morph target, ex: App\\Models\\User']
  notifiable_id   bigint       [not null]
  data            text         [not null, note: 'Payload JSON']
  read_at         timestamp
  created_at      timestamp    [not null]
  updated_at      timestamp    [not null]

  indexes {
    (notifiable_type, notifiable_id) [name: 'notifications_notifiable_type_notifiable_id_index']
  }

  Note: 'Table native Laravel pour le canal database.'
}

// ─── 12b. NOTIFICATION_DELIVERIES ────────────────────────────
Table notification_deliveries {
  id                  bigint          [pk, increment, not null]
  event_id            uuid            [not null, note: 'UUID commun aux livraisons du même événement']
  event_key           varchar(120)    [note: 'Clé métier de déduplication d événement']
  dedupe_key          varchar(191)    [unique, note: 'Clé unique de déduplication de cette livraison']
  attempt_id          uuid            [not null, unique]
  attempt_number      int             [not null, default: 1]
  notification_id     uuid            [note: 'FK logique vers notifications.id (canal database uniquement)']
  notification_type   varchar(255)    [not null]
  notifiable_type     varchar(255)    [not null]
  notifiable_id       bigint          [not null]
  reservation_id      bigint
  document_id         bigint
  channel             varchar(50)     [not null, note: 'mail | database | broadcast | slack | sms']
  priority            varchar(20)     [not null, default: 'normal', note: 'critical | high | normal | low']
  recipient_email     varchar(255)
  status              delivery_status [not null]
  provider            varchar(50)
  provider_message_id varchar(255)
  payload             json
  sent_at             timestamp
  failed_at           timestamp
  error_message       text
  created_at          timestamp       [not null]
  updated_at          timestamp       [not null]

  indexes {
    (attempt_id)                     [unique, name: 'uq_notification_deliveries_attempt_id']
    (dedupe_key)                     [unique, name: 'uq_notification_deliveries_dedupe_key']
    (event_id, channel, notifiable_type, notifiable_id, attempt_number) [unique, name: 'uq_notification_deliveries_event_channel_notifiable_attempt']
    (event_id)                       [name: 'idx_notification_deliveries_event_id']
    (event_key)                      [name: 'idx_notification_deliveries_event_key']
    (notification_id)                [name: 'idx_notification_deliveries_notification_id']
    (notification_type)              [name: 'idx_notification_deliveries_notification_type']
    (notifiable_type, notifiable_id) [name: 'idx_notification_deliveries_notifiable']
    (reservation_id)                 [name: 'idx_notification_deliveries_reservation_id']
    (document_id)                    [name: 'idx_notification_deliveries_document_id']
    (channel)                        [name: 'idx_notification_deliveries_channel']
    (priority)                       [name: 'idx_notification_deliveries_priority']
    (status)                         [name: 'idx_notification_deliveries_status']
    (recipient_email)                [name: 'idx_notification_deliveries_recipient_email']
    (channel, status)                [name: 'idx_notification_deliveries_channel_status']
    (sent_at)                        [name: 'idx_notification_deliveries_sent_at']
    (failed_at)                      [name: 'idx_notification_deliveries_failed_at']
    (created_at)                     [name: 'idx_notification_deliveries_created_at']
  }

  Note: 'Journal d audit des envois. Pas de FK sur notification_id pour survivre au nettoyage des notifications.'
}

// ─── 12c. USER_NOTIFICATION_PREFERENCES ──────────────────────
Table user_notification_preferences {
  id                                      bigint  [pk, increment, not null]
  user_id                                 bigint  [not null, unique]
  notify_reservation_updates_in_app       boolean [not null, default: true]
  notify_reservation_updates_email        boolean [not null, default: true]
  notify_driver_planning_in_app           boolean [not null, default: true]
  notify_driver_planning_email            boolean [not null, default: true]
  notify_admin_workflow_in_app            boolean [not null, default: true]
  notify_admin_workflow_email             boolean [not null, default: true]
  notify_last_minute_cancellation_in_app  boolean [not null, default: true]
  notify_last_minute_cancellation_email   boolean [not null, default: true]
  digest_frequency                        varchar(20) [not null, default: 'none', note: 'none | daily | weekly']
  quiet_hours_start                       tinyint unsigned [note: 'Heure de début des heures silencieuses (0-23)']
  quiet_hours_end                         tinyint unsigned [note: 'Heure de fin des heures silencieuses (0-23)']
  created_at                              timestamp
  updated_at                              timestamp

  indexes {
    (user_id) [unique, name: 'user_notification_preferences_user_id_unique']
  }

  Note: '1 ligne par utilisateur — créée à la demande.'
}

// ─── 12d. NOTIFICATION_DIGEST_QUEUES ─────────────────────────
Table notification_digest_queues {
  id             bigint       [pk, increment, not null]
  user_id        bigint       [not null]
  event_key      varchar(120) [not null]
  category       varchar(100) [not null]
  priority       varchar(20)  [not null, default: 'normal']
  title          varchar(255) [not null]
  message        text         [not null]
  reservation_id bigint
  document_id    bigint
  payload        json
  available_at   timestamp
  sent_at        timestamp
  created_at     timestamp
  updated_at     timestamp

  indexes {
    (user_id, sent_at)       [name: 'idx_notification_digest_queues_user_sent']
    (available_at, sent_at)  [name: 'idx_notification_digest_queues_available_sent']
    (category, priority)     [name: 'idx_notification_digest_queues_category_priority']
  }

  Note: 'File d attente pour l agrégation et l envoi différé des notifications digest.'
}

// ─── 13. UNAVAILABILITIES ────────────────────────────────────
Table unavailabilities {
  id                 bigint                     [pk, increment, not null]
  reason_type        unavailability_reason_type [not null]
  reason             varchar(500)
  driver_id          bigint
  vehicle_id         bigint
  start_datetime     datetime                   [not null]
  end_datetime       datetime                   [not null]
  is_active          boolean                    [not null, default: true]
  created_by_user_id bigint                     [not null]
  created_at         timestamp                  [not null]
  updated_at         timestamp                  [not null]

  indexes {
    (reason_type)                  [name: 'idx_unavailabilities_reason_type']
    (driver_id)                    [name: 'idx_unavailabilities_driver_id']
    (vehicle_id)                   [name: 'idx_unavailabilities_vehicle_id']
    (is_active)                    [name: 'idx_unavailabilities_is_active']
    (created_by_user_id)           [name: 'idx_unavailabilities_created_by_user_id']
    (start_datetime, end_datetime) [name: 'idx_unavailabilities_start_end']
    (driver_id, start_datetime)    [name: 'idx_unavailabilities_driver_start']
    (vehicle_id, start_datetime)   [name: 'idx_unavailabilities_vehicle_start']
  }

  Note: 'CHECK : (driver_id IS NOT NULL AND vehicle_id IS NULL AND reason_type = driver) OR (driver_id IS NULL AND vehicle_id IS NOT NULL AND reason_type = vehicle)'
}

// ─── 14. UNAVAILABILITIES_HISTORY ────────────────────────────
Table unavailabilities_history {
  id                 bigint                     [pk, increment, not null]
  unavailability_id  bigint                     [not null]
  old_reason_type    unavailability_reason_type
  new_reason_type    unavailability_reason_type
  old_start_datetime datetime
  new_start_datetime datetime
  old_end_datetime   datetime
  new_end_datetime   datetime
  old_reason         varchar(500)
  new_reason         varchar(500)
  changed_by_user_id bigint                     [not null]
  change_reason      varchar(500)
  created_at         timestamp                  [not null]

  indexes {
    (unavailability_id)             [name: 'idx_unavailabilities_history_unavailability_id']
    (changed_by_user_id)            [name: 'idx_unavailabilities_history_changed_by_user_id']
    (created_at)                    [name: 'idx_unavailabilities_history_created_at']
    (unavailability_id, created_at) [name: 'idx_unavailabilities_history_unavailability_created_at']
  }

  Note: 'Table immuable — created_at uniquement, jamais de updated_at.'
}

// ─── 15. RESERVATION_STATUS_HISTORY ──────────────────────────
Table reservation_status_history {
  id                 bigint             [pk, increment, not null]
  reservation_id     bigint             [not null]
  old_status         reservation_status [not null]
  new_status         reservation_status [not null]
  changed_by_user_id bigint             [not null]
  reason             text
  created_at         timestamp          [not null]

  indexes {
    (reservation_id)             [name: 'idx_reservation_status_history_reservation_id']
    (changed_by_user_id)         [name: 'idx_reservation_status_history_changed_by_user_id']
    (created_at)                 [name: 'idx_reservation_status_history_created_at']
    (reservation_id, created_at) [name: 'idx_reservation_status_history_reservation_created_at']
    (new_status)                 [name: 'idx_reservation_status_history_new_status']
  }

  Note: 'Table immuable — created_at uniquement.'
}

// ─── 16. RESERVATION_ASSIGNMENT_HISTORY ──────────────────────
Table reservation_assignment_history {
  id                 bigint               [pk, increment, not null]
  reservation_id     bigint               [not null]
  assignment_type    assignment_type_enum [not null]
  old_driver_id      bigint
  new_driver_id      bigint
  old_vehicle_id     bigint
  new_vehicle_id     bigint
  changed_by_user_id bigint               [not null]
  reason             text
  created_at         timestamp            [not null]

  indexes {
    (reservation_id)             [name: 'idx_reservation_assignment_history_reservation_id']
    (assignment_type)            [name: 'idx_reservation_assignment_history_assignment_type']
    (changed_by_user_id)         [name: 'idx_reservation_assignment_history_changed_by_user_id']
    (created_at)                 [name: 'idx_reservation_assignment_history_created_at']
    (reservation_id, created_at) [name: 'idx_reservation_assignment_history_reservation_created_at']
    (new_driver_id)              [name: 'idx_reservation_assignment_history_new_driver_id']
    (new_vehicle_id)             [name: 'idx_reservation_assignment_history_new_vehicle_id']
  }

  Note: 'Table immuable — created_at uniquement.'
}

// ─── 17. ORG_REGISTRATION_REQUESTS ───────────────────────────
Table org_registration_requests {
  id                  bigint            [pk, increment, not null]
  request_by_user_id  bigint            [not null]
  organization_name   varchar(255)      [not null]
  organization_type   organization_type [not null]
  enterprise_number   varchar(50)       [note: 'Numéro BCE — recommandé pour les ASBL']
  official_email      varchar(255)      [not null]
  phone               varchar(20)
  location_id         bigint
  contact_person_name varchar(100)
  contact_person_role varchar(100)
  proof_document_id   bigint            [note: 'FK vers documents.id — justificatif joint']
  comment             text
  status              request_status    [not null]
  confidence_note     int               [note: 'Score de confiance calculé automatiquement (0-100). Le détail est calculé à la volée par l API, non stocké.']
  reviewed_by_user_id bigint
  reviewed_at         timestamp
  rejection_reason    text
  created_at          timestamp         [not null]
  updated_at          timestamp         [not null]

  indexes {
    (request_by_user_id)  [name: 'idx_org_registration_requests_request_by_user_id']
    (organization_type)   [name: 'idx_org_registration_requests_organization_type']
    (official_email)      [name: 'idx_org_registration_requests_official_email']
    (location_id)         [name: 'idx_org_registration_requests_location_id']
    (status)              [name: 'idx_org_registration_requests_status']
    (confidence_note)     [name: 'idx_org_registration_requests_confidence_note']
    (reviewed_by_user_id) [name: 'idx_org_registration_requests_reviewed_by_user_id']
    (created_at)          [name: 'idx_org_registration_requests_created_at']
    (status, created_at)  [name: 'idx_org_registration_requests_status_created_at']
    (enterprise_number)   [name: 'idx_org_registration_requests_enterprise_number']
  }
}

// ─── 18. USER_ORG_REQUESTS ───────────────────────────────────
Table user_org_requests {
  request_id           bigint         [pk, increment, not null, note: 'PK nommée request_id (ne pas renommer en id)']
  organization_id      bigint         [not null]
  requested_by_user_id bigint         [not null]
  requested_role       varchar(50)    [not null, note: 'prof | directeur | animateur | responsable | referent']
  justification        text
  proof_document_id    bigint         [note: 'FK vers documents.id — pièce jointe optionnelle']
  status               request_status [not null]
  confidence_note      int            [note: 'Score de confiance calculé automatiquement (0-100). Le détail est calculé à la volée par l API, non stocké.']
  reviewed_by_user_id  bigint
  reviewed_at          timestamp
  rejection_reason     text
  created_at           timestamp      [not null]
  updated_at           timestamp      [not null]

  indexes {
    (organization_id)              [name: 'idx_user_org_requests_organization_id']
    (requested_by_user_id)         [name: 'idx_user_org_requests_requested_by_user_id']
    (status)                       [name: 'idx_user_org_requests_status']
    (reviewed_by_user_id)          [name: 'idx_user_org_requests_reviewed_by_user_id']
    (created_at)                   [name: 'idx_user_org_requests_created_at']
    (organization_id, status)      [name: 'idx_user_org_requests_org_status']
    (requested_by_user_id, status) [name: 'idx_user_org_requests_user_status']
  }
}

// ─── 19. MUNICIPALITIES ──────────────────────────────────────
Table municipalities {
  id          bigint       [pk, increment, not null]
  name        varchar(100) [not null]
  external_id varchar(500) [note: 'GeonameId GeoNames']
  nis_code    varchar(20)  [note: 'Code NIS INS belge']
  country     varchar(2)   [not null, default: 'BE']
  postal_code varchar(20)
  source      varchar(50)  [note: 'manual | geonames | statbel']
  is_active   boolean      [not null, default: false, note: 'Une seule commune active à la fois']
  synced_at   timestamp
  created_at  timestamp    [not null]
  updated_at  timestamp    [not null]

  indexes {
    (name)        [name: 'idx_municipalities_name']
    (external_id) [name: 'idx_municipalities_external_id']
    (nis_code)    [name: 'idx_municipalities_nis_code']
    (country)     [name: 'idx_municipalities_country']
    (is_active)   [name: 'idx_municipalities_is_active']
  }
}

// ─── 20. MUNICIPALITY_LOCALITIES ─────────────────────────────
Table municipality_localities {
  id              bigint       [pk, increment, not null]
  municipality_id bigint       [not null]
  name            varchar(100) [not null]
  normalized_name varchar(120) [not null, note: 'Nom normalisé (sans accents, minuscules) pour le scoring']
  external_id     varchar(500) [note: 'GeonameId GeoNames']
  source          varchar(50)  [note: 'manual | geonames | statbel']
  is_active       boolean      [not null, default: true]
  created_at      timestamp    [not null]
  updated_at      timestamp    [not null]

  indexes {
    (municipality_id)                  [name: 'idx_municipality_localities_municipality_id']
    (normalized_name)                  [name: 'idx_municipality_localities_normalized_name']
    (external_id)                      [name: 'idx_municipality_localities_external_id']
    (is_active)                        [name: 'idx_municipality_localities_is_active']
    (municipality_id, normalized_name) [unique, name: 'uq_municipality_localities_municipality_normalized_name']
  }
}

// ─── 21. DOCUMENT_ACCESS_TOKENS ──────────────────────────────
Table document_access_tokens {
  id          bigint       [pk, increment, not null]
  document_id bigint       [not null]
  user_id     bigint
  token       varchar(100) [not null, unique, note: 'Token signé transmis dans l URL de téléchargement']
  expires_at  timestamp    [not null]
  used_at     timestamp
  revoked_at  timestamp
  created_at  timestamp
  updated_at  timestamp

  indexes {
    (token)                  [unique, name: 'document_access_tokens_token_unique']
    (document_id, used_at)   [name: 'idx_document_access_tokens_document_used']
    (expires_at, used_at)    [name: 'idx_document_access_tokens_expires_used']
  }

  Note: 'Liens de téléchargement à durée limitée pour les documents. Révocables explicitement.'
}

// ─── 22. DOCUMENT_ACCESS_LOGS ────────────────────────────────
Table document_access_logs {
  id                      bigint       [pk, increment, not null]
  document_id             bigint       [not null]
  document_access_token_id bigint
  user_id                 bigint
  ip_address              varchar(45)
  user_agent              text
  is_success              boolean      [not null]
  failure_reason          varchar(120)
  created_at              timestamp
  updated_at              timestamp

  indexes {
    (document_id, is_success) [name: 'idx_document_access_logs_document_success']
  }

  Note: 'Audit de tous les accès aux documents (réussis et échoués).'
}

// ─── 23. API_IDEMPOTENCY_KEYS ────────────────────────────────
Table api_idempotency_keys {
  id                bigint       [pk, increment, not null]
  user_id           bigint       [not null]
  idempotency_key   varchar(128) [not null]
  method            varchar(10)  [not null]
  route_name        varchar(191) [not null]
  request_hash      varchar(64)  [not null]
  response_status   smallint unsigned
  response_body     json
  completed_at      timestamp
  created_at        timestamp
  updated_at        timestamp

  indexes {
    (user_id, idempotency_key, method, route_name) [unique, name: 'uq_api_idempotency_user_key_method_route']
    (user_id, created_at)                          [name: 'idx_api_idempotency_user_created_at']
    (completed_at)                                 [name: 'idx_api_idempotency_completed_at']
  }

  Note: 'Garantit l idempotence des requêtes POST/PATCH critiques. Nettoyage périodique recommandé.'
}

// ─── 24. DOMAIN_EVENTS ───────────────────────────────────────
Table domain_events {
  id             bigint       [pk, increment, not null]
  aggregate_type varchar(100) [not null, note: 'Ex: reservation | organization | driver']
  aggregate_id   bigint       [not null]
  event_type     varchar(150) [not null, note: 'Ex: reservation.created | reservation.approved']
  actor_user_id  bigint
  old_values     json
  new_values     json
  context        json
  created_at     timestamp    [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    (aggregate_type, aggregate_id) [name: 'idx_domain_events_aggregate']
    (event_type)                   [name: 'idx_domain_events_event_type']
    (created_at)                   [name: 'idx_domain_events_created_at']
  }

  Note: 'Journal immuable des événements métier. Pas de updated_at. Source de vérité pour l audit.'
}

// ─── 25. PLANNING_EXPORT_REQUESTS ────────────────────────────
Table planning_export_requests {
  id                   bigint      [pk, increment, not null]
  requested_by_user_id bigint      [not null]
  start_date           date        [not null]
  end_date             date        [not null]
  statuses             json        [note: 'Filtres de statut à inclure dans l export']
  filters              json        [note: 'Filtres additionnels (org, driver, vehicle...)']
  status               varchar(32) [not null, default: 'pending', note: 'pending | processing | completed | failed']
  document_id          bigint      [note: 'Document généré une fois complété']
  error_message        text
  requested_at         timestamp
  started_at           timestamp
  completed_at         timestamp
  failed_at            timestamp
  created_at           timestamp
  updated_at           timestamp

  indexes {
    (requested_by_user_id, status) [name: 'idx_planning_exports_user_status']
    (requested_at)                 [name: 'idx_planning_exports_requested_at']
  }

  Note: 'Export asynchrone du planning en Excel. Créé en pending, traité par une job queue.'
}

// ============================================================
// TABLES — INFRASTRUCTURE LARAVEL
// ============================================================

// ─── Spatie laravel-permission ───────────────────────────────
Table permissions {
  id         bigint       [pk, increment, not null]
  name       varchar(255) [not null]
  guard_name varchar(255) [not null]
  created_at timestamp
  updated_at timestamp

  indexes {
    (name, guard_name) [unique]
  }

  Note: 'Permissions granulaires Spatie. 44 permissions définies dans RolesAndPermissionsSeeder.'
}

Table roles {
  id         bigint       [pk, increment, not null]
  name       varchar(255) [not null]
  guard_name varchar(255) [not null]
  created_at timestamp
  updated_at timestamp

  indexes {
    (name, guard_name) [unique]
  }

  Note: '5 rôles : admin, agent_communal, responsable_organisation, user, chauffeur.'
}

Table model_has_permissions {
  permission_id bigint       [not null]
  model_type    varchar(255) [not null]
  model_id      bigint       [not null]

  indexes {
    (permission_id, model_id, model_type) [pk, name: 'model_has_permissions_permission_model_type_primary']
    (model_id, model_type)                [name: 'model_has_permissions_model_id_model_type_index']
  }
}

Table model_has_roles {
  role_id    bigint       [not null]
  model_type varchar(255) [not null]
  model_id   bigint       [not null]

  indexes {
    (role_id, model_id, model_type) [pk, name: 'model_has_roles_role_model_type_primary']
    (model_id, model_type)          [name: 'model_has_roles_model_id_model_type_index']
  }
}

Table role_has_permissions {
  permission_id bigint [not null]
  role_id       bigint [not null]

  indexes {
    (permission_id, role_id) [pk, name: 'role_has_permissions_permission_id_role_id_primary']
  }
}

Table sessions {
  id            varchar(255) [pk, not null]
  user_id       bigint
  ip_address    varchar(45)
  user_agent    text
  payload       longtext     [not null]
  last_activity int          [not null]

  indexes {
    (user_id)       [name: 'sessions_user_id_index']
    (last_activity) [name: 'sessions_last_activity_index']
  }

  Note: 'Sessions Laravel (utilisées pour la démo web et l interface backend inspector).'
}

Table personal_access_tokens {
  id             bigint       [pk, increment, not null]
  tokenable_type varchar(255) [not null]
  tokenable_id   bigint       [not null]
  name           varchar(255) [not null]
  token          varchar(64)  [not null, unique]
  abilities      text
  last_used_at   timestamp
  expires_at     timestamp
  created_at     timestamp
  updated_at     timestamp

  indexes {
    (tokenable_type, tokenable_id) [name: 'personal_access_tokens_tokenable_type_tokenable_id_index']
  }

  Note: 'Tokens Sanctum pour l authentification API.'
}

Table jobs {
  id           bigint   [pk, increment, not null]
  queue        varchar  [not null]
  payload      longtext [not null]
  attempts     tinyint  [not null]
  reserved_at  int
  available_at int      [not null]
  created_at   int      [not null]

  indexes {
    (queue) [name: 'jobs_queue_index']
  }
}

Table job_batches {
  id             varchar  [pk, not null]
  name           varchar  [not null]
  total_jobs     int      [not null]
  pending_jobs   int      [not null]
  failed_jobs    int      [not null]
  failed_job_ids longtext [not null]
  options        mediumtext
  cancelled_at   int
  created_at     int      [not null]
  finished_at    int
}

Table failed_jobs {
  id         bigint    [pk, increment, not null]
  uuid       varchar   [not null, unique]
  connection text      [not null]
  queue      text      [not null]
  payload    longtext  [not null]
  exception  longtext  [not null]
  failed_at  timestamp [not null]
}

Table cache {
  key        varchar(255) [pk, not null]
  value      mediumtext   [not null]
  expiration bigint       [not null]
}

Table cache_locks {
  key        varchar(255) [pk, not null]
  owner      varchar(255) [not null]
  expiration bigint       [not null]
}

// ============================================================
// RELATIONS / FOREIGN KEYS
// ============================================================

// users
Ref: drivers.user_id > users.id [delete: cascade, update: cascade]

// organizations
Ref: organizations.location_id > locations.id [delete: set null, update: cascade]
Ref: organizations.proof_document_id > documents.id [delete: set null, update: cascade]

// user_organization
Ref: user_organization.user_id > users.id [delete: cascade, update: cascade]
Ref: user_organization.organization_id > organizations.id [delete: cascade, update: cascade]

// recurrences (pas de FK — table autonome)

// reservations
Ref: reservations.requested_by_user_id > users.id [delete: restrict, update: cascade]
Ref: reservations.organization_id > organizations.id [delete: restrict, update: cascade]
Ref: reservations.pickup_location_id > locations.id [delete: restrict, update: cascade]
Ref: reservations.destination_location_id > locations.id [delete: restrict, update: cascade]
Ref: reservations.driver_id > drivers.id [delete: set null, update: cascade]
Ref: reservations.vehicle_id > vehicles.id [delete: set null, update: cascade]
Ref: reservations.recurrence_id > recurrences.id [delete: set null, update: cascade]
Ref: reservations.validated_by_user_id > users.id [delete: set null, update: cascade]
Ref: reservations.cancelled_by_user_id > users.id [delete: set null, update: cascade]

// reservation_conflicts
Ref: reservation_conflicts.reservation_id > reservations.id [delete: cascade, update: cascade]
Ref: reservation_conflicts.related_reservation_id > reservations.id [delete: set null, update: cascade]
Ref: reservation_conflicts.resolved_by_user_id > users.id [delete: set null, update: cascade]

// council_decisions
Ref: council_decisions.reservation_id > reservations.id [delete: cascade, update: cascade]
Ref: council_decisions.recorded_by_user_id > users.id [delete: restrict, update: cascade]

// documents
Ref: documents.reservation_id > reservations.id [delete: set null, update: cascade]
Ref: documents.user_id > users.id [delete: set null, update: cascade]

// document_reservation (pivot)
Ref: document_reservation.document_id > documents.id [delete: cascade, update: cascade]
Ref: document_reservation.reservation_id > reservations.id [delete: cascade, update: cascade]

// notification_deliveries
Ref: notification_deliveries.reservation_id > reservations.id [delete: set null, update: cascade]
Ref: notification_deliveries.document_id > documents.id [delete: set null, update: cascade]

// user_notification_preferences
Ref: user_notification_preferences.user_id > users.id [delete: cascade, update: cascade]

// notification_digest_queues
Ref: notification_digest_queues.user_id > users.id [delete: cascade, update: cascade]
Ref: notification_digest_queues.reservation_id > reservations.id [delete: set null, update: cascade]
Ref: notification_digest_queues.document_id > documents.id [delete: set null, update: cascade]

// unavailabilities
Ref: unavailabilities.driver_id > drivers.id [delete: restrict, update: cascade]
Ref: unavailabilities.vehicle_id > vehicles.id [delete: restrict, update: cascade]
Ref: unavailabilities.created_by_user_id > users.id [delete: restrict, update: cascade]

// unavailabilities_history
Ref: unavailabilities_history.unavailability_id > unavailabilities.id [delete: cascade, update: cascade]
Ref: unavailabilities_history.changed_by_user_id > users.id [delete: restrict, update: cascade]

// reservation_status_history
Ref: reservation_status_history.reservation_id > reservations.id [delete: cascade, update: cascade]
Ref: reservation_status_history.changed_by_user_id > users.id [delete: restrict, update: cascade]

// reservation_assignment_history
Ref: reservation_assignment_history.reservation_id > reservations.id [delete: cascade, update: cascade]
Ref: reservation_assignment_history.old_driver_id > drivers.id [delete: set null, update: cascade]
Ref: reservation_assignment_history.new_driver_id > drivers.id [delete: set null, update: cascade]
Ref: reservation_assignment_history.old_vehicle_id > vehicles.id [delete: set null, update: cascade]
Ref: reservation_assignment_history.new_vehicle_id > vehicles.id [delete: set null, update: cascade]
Ref: reservation_assignment_history.changed_by_user_id > users.id [delete: restrict, update: cascade]

// org_registration_requests
Ref: org_registration_requests.request_by_user_id > users.id [delete: restrict, update: cascade]
Ref: org_registration_requests.location_id > locations.id [delete: set null, update: cascade]
Ref: org_registration_requests.proof_document_id > documents.id [delete: set null, update: cascade]
Ref: org_registration_requests.reviewed_by_user_id > users.id [delete: set null, update: cascade]

// user_org_requests
Ref: user_org_requests.organization_id > organizations.id [delete: restrict, update: cascade]
Ref: user_org_requests.requested_by_user_id > users.id [delete: restrict, update: cascade]
Ref: user_org_requests.proof_document_id > documents.id [delete: set null, update: cascade]
Ref: user_org_requests.reviewed_by_user_id > users.id [delete: set null, update: cascade]

// municipalities / localities
Ref: municipality_localities.municipality_id > municipalities.id [delete: cascade, update: cascade]

// document_access_tokens
Ref: document_access_tokens.document_id > documents.id [delete: cascade, update: cascade]
Ref: document_access_tokens.user_id > users.id [delete: set null, update: cascade]

// document_access_logs
Ref: document_access_logs.document_id > documents.id [delete: cascade, update: cascade]
Ref: document_access_logs.document_access_token_id > document_access_tokens.id [delete: set null, update: cascade]
Ref: document_access_logs.user_id > users.id [delete: set null, update: cascade]

// api_idempotency_keys
Ref: api_idempotency_keys.user_id > users.id [delete: cascade, update: cascade]

// domain_events
Ref: domain_events.actor_user_id > users.id [delete: set null, update: cascade]

// planning_export_requests
Ref: planning_export_requests.requested_by_user_id > users.id [delete: cascade, update: cascade]
Ref: planning_export_requests.document_id > documents.id [delete: set null, update: cascade]

// sessions
