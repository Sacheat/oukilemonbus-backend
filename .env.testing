APP_NAME="Bus Communal"
APP_ENV=testing
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
FRONTEND_URL=http://localhost:3000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_BE

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=bus_communal_test
DB_USERNAME=bus_user
DB_PASSWORD=bus_password
DB_PREFIX=

SESSION_DRIVER=array
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_SECURE_COOKIE=false
SESSION_PARTITIONED_COOKIE=false

SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000,localhost:8080,127.0.0.1:8080
SANCTUM_TOKEN_PREFIX=bc_test_
SANCTUM_TOKEN_EXPIRATION=
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
QUEUE_NAME_CRITICAL=critical
QUEUE_NAME_DEFAULT=default
QUEUE_NAME_LOW=low

CACHE_STORE=array

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

NOTIFICATIONS_LAST_MINUTE_CANCELLATION_HOURS=24
NOTIFICATIONS_COOLDOWN_MINUTES=15
NOTIFICATIONS_MAIL_MAX_ATTACHMENT_BYTES=5242880
NOTIFICATIONS_SIGNED_LINK_EXPIRATION_MINUTES=1440
NOTIFICATIONS_DIGEST_HOURLY_MINUTE=5
NOTIFICATIONS_DIGEST_DAILY_HOUR=8
NOTIFICATIONS_DIGEST_DAILY_MINUTE=0
NOTIFICATIONS_OBS_MAX_FAILED_DELIVERIES_24H=20
NOTIFICATIONS_OBS_MAX_HIGH_PENDING_OVER_5M=0
NOTIFICATIONS_OBS_MAX_LATE_DIGESTS_OVER_30M=10

ORS_API_KEY=test-key
ORS_BASE_URL=https://ors.test

MUNICIPALITY_NAME=Dinant
